generator client {
  provider      = "prisma-client-js"
  // "native" covers whatever OS builds the client (GitHub Actions' runner,
  // debian-openssl-3.0.x); the VPS this gets deployed to resolves to
  // debian-openssl-1.1.x at runtime, so both engines need to ship in the
  // built artifact for `npm run build` on CI to produce something that
  // actually runs on the target machine.
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryKey {
  IMMIGRATION
  HOUSING
  HEALTH
  EMPLOYMENT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  REJECTED
  ERROR
}

model Category {
  id        String      @id @default(cuid())
  key       CategoryKey @unique
  labelFr   String
  labelAr   String
  articles  Article[]

  @@map("categories")
}

model FeedSource {
  id            String    @id @default(cuid())
  name          String
  url           String    @unique
  organization  String
  isActive      Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  articles      Article[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("feed_sources")
}

model Article {
  id               String        @id @default(cuid())
  guid             String        @unique // original RSS entry guid/link, used for de-dup
  sourceUrl        String
  originalTitleFr  String
  originalBodyFr   String        @db.Text

  titleAr          String
  tldrAr           String[]      // 3 bullet-point summary
  stepsAr          String[]      // actionable steps
  bodyAr           String        @db.Text

  titleFr          String?
  tldrFr           String[]
  stepsFr          String[]
  bodyFr           String?       @db.Text

  status           ArticleStatus @default(DRAFT)
  publishedAt      DateTime?

  category         Category      @relation(fields: [categoryId], references: [id])
  categoryId       String

  feedSource       FeedSource    @relation(fields: [feedSourceId], references: [id])
  feedSourceId     String

  aiModel          String?
  aiProcessedAt    DateTime?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

// A guid the AI genuinely evaluated (not a mock fallback) and judged not
// relevant to the app's categories. RSS feeds often keep showing the same
// "N latest items" window for days, so without this the pipeline would
// re-spend an AI call re-rejecting the same item on every run.
model RejectedItem {
  id        String   @id @default(cuid())
  guid      String   @unique
  createdAt DateTime @default(now())

  @@map("rejected_items")
}
