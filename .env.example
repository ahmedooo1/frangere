# --- Database (PostgreSQL, e.g. Supabase / Neon / local Docker) ---
DATABASE_URL="postgresql://user:password@localhost:5432/frangere?schema=public"

# --- Anthropic Claude API ---
# If left empty, the pipeline automatically falls back to deterministic mock
# translations/summaries so the app builds and runs end-to-end out of the box.
ANTHROPIC_API_KEY=""

# --- Automation ---
# Set to "false" to disable the in-process node-cron scheduler (e.g. on
# serverless platforms) and rely on an external scheduler calling
# `npm run cron:run` or `POST /api/feed` instead.
CRON_ENABLED="true"
# Standard cron syntax. Default: every 6 hours.
CRON_SCHEDULE="0 */6 * * *"
# Optional bearer secret required to call POST /api/feed manually/externally.
# Leave empty to allow unauthenticated manual triggers (fine for local dev only).
CRON_SECRET=""
